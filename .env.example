# ---- Gemini / google-genai (native SDK reads GEMINI_API_KEY automatically) ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tru_scouting
POSTGRES_USER=tru_admin
POSTGRES_PASSWORD=change_me

# ---- App ----
APP_ENV=development
UPLOAD_TMP_DIR=/tmp/tru_uploads
# Film is uploaded straight to this host, so this is a real choice now
# rather than a limit imposed by a PaaS proxy. A full game shot at 60fps
# on a phone can run to several GB.
MAX_UPLOAD_MB=2048
# Every log line is JSON with a per-request correlation id — see
# app/core/logging_config.py. DEBUG for more detail while diagnosing something.
LOG_LEVEL=INFO

# ---- Phase 1 local/private defaults ----
TRUGRADE_DEMO_MODE=true
AI_PROVIDER=google
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-5-mini
GOOGLE_MODEL=gemini-2.5-flash
ANTHROPIC_MODEL=claude-sonnet-4-5
AI_SEND_VIDEO=false
AI_SEND_FRAMES=true
AI_MAX_FRAMES_PER_PLAY=8
YOLO_MODEL_PATH=yolo11n.pt
TRUGRADE_STORAGE_DIR=backend/storage
# native processes every source frame; set a number only for lower-cost previews.
ANALYSIS_FPS=native
# JPEG quality for extracted frames. These are model input, not something a
# person looks at — OpenCV's default of 95 is near-lossless and made
# native-rate extraction run to tens of GB per clip.
FRAME_JPEG_QUALITY=80
# Reclaim extracted frames once identification finishes (a keyframe is kept
# so field calibration still works, and frames are re-derivable from the
# source video). Worker-side setting.
DISCARD_FRAMES_AFTER_IDENTITY=true
# How many times a job may be handed to a worker before it is failed
# rather than retried. Guards against a job that kills its worker outright
# (an OOM on oversized film, say) being requeued forever and blocking
# every job behind it.
JOB_MAX_ATTEMPTS=3
# --- Analysis worker (scripts/run_worker.py) ---
# Label for this worker in the job queue; defaults to hostname:pid.
# WORKER_ID=
WORKER_POLL_INTERVAL_S=5
TRUGRADE_DEVICE=auto
ENABLE_BIOMECHANICS=true
POSE_MODEL_PATH=yolo11n-pose.pt
# Replace with football-specific trained weights for production accuracy.
# With a stock yolo model this is COCO's "sports ball" class — trained on
# soccer balls and basketballs, not on a football. See docs/TRAIN_BALL_MODEL.md.
BALL_MODEL_PATH=yolo11n.pt
# Plausibility filtering for ball detections (backend/vision/ball_filter.py).
# Rejects candidates that cannot physically be a football, judged against
# the players in the same frame. Set false once BALL_MODEL_PATH points at
# football-trained weights — a model that knows the object doesn't need
# heuristics second-guessing it.
BALL_STRICT_FILTER=true
BALL_MIN_CONFIDENCE=0.35
JERSEY_ID_MIN_READS=2
JERSEY_ID_CONFIDENCE=.62
JERSEY_ID_MARGIN=.12

# ---- Auth ----
# Leave unset for local dev (no auth). Set before exposing the app publicly —
# every /api/v1/scout/*, /api/v1/athletes, /api/v1/evaluations, and V2 (/api/
# videos, /api/analysis, /api/players, /api/football) route then requires a
# matching X-API-Key header. /api/v1/health and /api/health/* always stay
# open. Outside a local/demo/test APP_ENV, the app refuses to start at all
# without this set — see backend/security/identity.py.
# The frontend bundle also needs this same value baked in as VITE_API_KEY
# (below) so the deployed site can actually call its own API.
API_KEY=
# Comma-separated browser origins. Leave empty for same-origin only. Wildcard
# origins are rejected outside local/demo/test environments.
CORS_ALLOW_ORIGINS=
# Baked into the frontend bundle at build time (see frontend/src/api/client.ts
# and Dockerfile) and sent as X-API-Key on every request. Set this to the
# same value as API_KEY above. Leave both unset for local dev.
VITE_API_KEY=

# ---- Outbound email (password reset) ----
# Plain SMTP — works with any provider's SMTP relay (SendGrid, Postmark, SES,
# Gmail, your domain host). Leave SMTP_HOST unset in local/demo/test and the
# reset link is returned directly in the API response instead of emailed
# (see app/core/email.py) — outside those environments, leaving it unset
# means password reset honestly reports itself as unavailable rather than
# pretending to send an email it can't.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
